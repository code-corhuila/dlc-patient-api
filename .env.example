# Every variable dlc-patient-api reads, with placeholders only (Annex I). Copy to .env, never commit it.
SERVER_PORT=8080
# Compose project per environment (Annex J.5.1): patients-api-dev, patients-api-qa or patients-api-main.
COMPOSE_PROJECT_NAME=patients-api-dev
# Shared network created by dlc-infra-postgres.
PLATFORM_NETWORK=platform
# Runtime credentials are separate from Liquibase; this directory contains password and optional root.crt.
PATIENTS_DB_SECRETS_DIR=replace-with-absolute-runtime-secret-directory
PATIENTS_DB_ENABLED=true
PATIENTS_DB_ENVIRONMENT=dev
PATIENTS_DB_HOST=dlc-dev-dlc-postgres-1
PATIENTS_DB_PORT=5432
PATIENTS_DB_NAME=di_lucca
PATIENTS_DB_PASSWORD_FILE=/run/secrets/patients/password
# Only dev permits disable; qa/main/prod require verify-full and the approved CA.
PATIENTS_DB_SSLMODE=disable
PATIENTS_DB_SSLROOTCERT=/run/secrets/patients/root.crt
# IAM issuer/audience must match IAM_JWT_ISSUER and IAM_JWT_AUDIENCE exactly.
PATIENTS_IAM_ENABLED=true
PATIENTS_IAM_ENVIRONMENT=dev
PATIENTS_IAM_BASE_URL=http://replace-with-private-iam-host:8080
PATIENTS_IAM_ISSUER=replace-with-approved-iam-issuer
PATIENTS_IAM_AUDIENCE=replace-with-iam-staff-audience
PATIENTS_IAM_REGISTRATION_PERMISSION=replace-with-approved-iam-registration-permission
PATIENTS_IAM_SECRETS_DIR=replace-with-absolute-iam-service-secret-directory
PATIENTS_IAM_SERVICE_TOKEN_FILE=/run/secrets/iam/service-token
